# Copie para .env e preencha. O arquivo .env NÃO deve ir para o Git.

# --- PostgreSQL (DB_PASS é obrigatório) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=troque_esta_senha

# --- Identidade da loja (aparece nos cupons) ---
PDV_NOME_LOJA=SUPERLELECMARKET
PDV_CNPJ=00.000.000/0001-00

# Cancelar item acima deste valor exige senha de supervisor
PDV_LIMITE_CANCEL_ITEM=50.00

# 1 apenas em desenvolvimento: cria usuarios de teste (1001/1234, 2001/4321, 9999/admin)
PDV_DEV=0
